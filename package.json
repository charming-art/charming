{
  "name": "charmingjs",
  "version": "0.0.20",
  "description": "The JavaScript library for generative art, with a data-driven rendering pipeline on Canvas and WebGL",
  "author": {
    "name": "Bairui SU",
    "url": "https://charmingjs.org/"
  },
  "license": "ISC",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "jsdelivr": "dist/charming.umd.min.js",
  "unpkg": "dist/charming.umd.min.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charming-art/api.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "test:update": "vitest --update",
    "test": "npm run test:js && npm run test:lint && npm run test:format",
    "test:js": "vitest",
    "test:lint": "eslint src test",
    "test:format": "prettier --check src test",
    "test:rust": "cargo test --manifest-path ./rust/Cargo.toml && cargo fmt --manifest-path ./rust/Cargo.toml --check",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "rm -rf dist && rollup -c",
    "build:rust": "node scripts/build-rust.js",
    "demo:pretext:dev": "pnpm --filter ./demo/pretext dev",
    "demo:pretext:build": "pnpm --filter ./demo/pretext build",
    "demo:pretext:preview": "pnpm --filter ./demo/pretext preview"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-terser": "^0.4.4",
    "d3": "^7.9.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "genji-theme-vitepress": "^0.2.8",
    "js-beautify": "^1.15.4",
    "jsdom": "^26.1.0",
    "prettier": "^3.8.1",
    "rollup": "^4.60.1",
    "vite": "^6.4.1",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.4",
    "d3-color": "^3.1.0",
    "d3-path": "^3.1.0",
    "figlet": "^1.12.0",
    "hachure-fill": "^0.5.2",
    "points-on-path": "^0.2.1"
  }
}
