{
  "extends": ["eslint:recommended", "prettier"],
  "env": {
    "es2020": true,
    "node": true,
    "browser": true
  },
  "parserOptions": {
    "sourceType": "module",
    "ecmaVersion": "latest"
  },
  "ignorePatterns": ["src/terminal/backend/"],
  "rules": {
    "no-cond-assign": "off"
  }
}
